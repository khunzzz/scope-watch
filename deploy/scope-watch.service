[Unit]
Description=scope-watch: проверка скоупов Standoff 365 / BI.ZONE
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=scopewatch
Group=scopewatch
EnvironmentFile=/etc/scope-watch.env
Environment=SCOPEWATCH_DATA=/var/lib/scope-watch
ExecStart=/opt/scope-watch/.venv/bin/scope-watch run
TimeoutStartSec=15min
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/scope-watch
